library(mvtnorm)
devtools::load_all('~/projects/hyponet')

set.seed(345)
sig <- matrix(c(1, .3, .4, 0, .5,
  .3,  1, .6, .2, .3,
  .4, .6,  1, .2, .1,
   0, .2, .2,  1, .5,
  .5, .3, .1, .5,  1), ncol = 5)
data <- rmvnorm(50, sigma = sig)

adjacency <- (abs(corpcor::cor2pcor(sig)) > .15) |> as.numeric() |> matrix(ncol = ncol(sig))
diag(adjacency) <- 0

ES <- exchangeableSampling(data, adjacency, ncores = 8)
PB <- parametricBootstrap(data, adjacency, ncores = 8)

SRMR(ES$original, adjacency)
SRMR(PB$original, adjacency)

SRMR(ES$copies[[1]], adjacency)
SRMR(PB$copies[[1]], adjacency)

sapply(ES$copies, SRMR, adjacency = adjacency) |> summary()
sapply(PB$copies, SRMR, adjacency = adjacency) |> summary()

str(ES)
str(PB)

