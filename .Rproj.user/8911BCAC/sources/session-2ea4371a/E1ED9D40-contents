\section{Outline}

\begin{itemize}
  \item Intro
  \begin{itemize}
    \item Relevance of testing in GGM
    \item Small theories / local hypotheses vs. assumption of completeness of network
    \item Necessity of testing local hypotheses embedded in larger networks \parencite[target system]{haslbeck2022}
  \end{itemize}
  \item Background
  \begin{itemize}
    \item Networks as $G = (\mathcal{V}, \mathcal{E})$ with $\mathcal{N}_i \subseteq \mathcal{E}$ as connected neighborhood of $i$
    \item Mostly partial correlations as $\bm{\Omega} = \bm{\Sigma}^{-1}$ and $\bm{\mathrm{P}} = \bm{I} - \bm{D} \bm{\Omega} \bm{D}$ with $\bm{D}$ a diagonal matrix with $\operatorname{diag}(\bm{\Omega})^{-\frac{1}{2}}$
    \item Exploratory Analyses for edge-set detection (glasso, ggmModSelect, etc)
    \item Developed alongside: bootstraps for single edges \parencite{epskamp2018}; in addition to traditional tests
    \item Tests for centralities \parencite{bringmann2019,spiller2020} - don't
    \item Wide-spread tests for group comparisons \parencite[NCT]{vanborkulo2023}
    \item CNA-approaches to testing full edge-set \parencite{du2025, kvetnaya2026}
    \item Recent development by \textcite{lin2025} to allow for efficient and local testing
  \end{itemize}
  \item Theory
  \begin{itemize}
    \item Weak edge-set hypotheses propose $G_0$ with $\mathcal{E} \subseteq \mathcal{E}_0$
    \item Four types of hypotheses (add a figure)
    \begin{enumerate}
      \item Target system in a fully specified model (test of local fit)
      \item Target system in a saturated model (system with covariates)
      \item Embedding in a fully specified model
      \item Embedding without constraints on covariate correlations
    \end{enumerate}
    \item True sparsity assumption may be unrealistic in psychological networks -> either via approximation checks or via simplified empirical structures (atan / nodewise)
  \end{itemize}
  \item Test-statistics
  \begin{itemize}
    \item From fit investigations \parencite{du2025, kvetnaya2026}, some SEM indices seem sensible
    \begin{itemize}
      \item Localized SRMR (fuzzy: limit for inclusion)
      \item $\chi^2$ / LRT in line with blockwise fit proposed by \parencite{norget2022} -> problems of $df$
      \item Blockwise RSMEA with same $df$ problems
    \end{itemize}
    \item Proposed by \textcite{lin2025}
    \begin{itemize}
      \item $F_{\Sigma}$ and $F_{\max}$
      \item $PRC_{\Sigma}$ and $PRC_{\max}$
    \end{itemize}
  \end{itemize}
  \item Testing approaches
  \begin{itemize}
    \item Parametric bootstrap seems to work to determine non-arbitrary cut-offs for fits \parencite{kvetnaya2026}
    \item \textcite{lin2025} propose exchangeable resampling
    \item Simulation shows both to perform similarly for full network hypotheses (\alert{Run full network simulation and add in supplement})
  \end{itemize}
  \item Goals
  \begin{itemize}
    \item Determine ability to test four types of hypotheses
    \item Compare ES to PB in performance
    \begin{itemize}
      \item Assumption: similar performance under optimal conditions (normality, large $N$)
      \item Assumption: better performance of ES under small $N$ and large surrounding
    \end{itemize}
    \item Derive recommendations regarding test statistics
  \end{itemize}
  \item Simulation study
  \begin{itemize}
    \item Four types of hypotheses
    \item Target system fixed at $p = 5$
    \item Target system misspecification (none, under, over)
    \item Non-target system misspecification (non, under) (over unnecessary because tested via hypo types 2 and 4)
    \item Testing type (ES, PB)
    \item Network size $p \in \{10, 20\}$; non-target network fixed
    \item Sample size $N \in \{25, 50, 100, 200, 400, 800\}$
  \end{itemize}
  \item Fuzziness simulation as a second simulation step
\end{itemize}

