library(mvtnorm)

set.seed(111)
sig <- matrix(c(1, .3, .4, .1, .5,
  .3, 1, .6, .2, .3,
  .4, .6, 1, .2, .1,
  .1, .2, .2, 1, .5,
  .5, .3, .1, .5, 1), ncol = 5)
data <- rmvnorm(75, sigma = sig)

adjacency <- (abs(corpcor::cor2pcor(sig)) > .1) |> as.numeric() |> matrix(ncol = ncol(sig))
diag(adjacency) <- 0

dats <- exchangeableSampling(data, adjacency, ncores = 8)

str(dats)

head(dats$hub)
